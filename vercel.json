{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/(.*)", "destination": "/output/$1" }
  ],
  "headers": [
    {
      "source": "/(.*).m3u",
      "headers": [
        {
          "key": "Content-Type",
          "value": "audio/x-mpegurl; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=1800"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
