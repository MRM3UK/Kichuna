{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pip install -r requirements.txt && python scripts/generate_playlists.py",
  "outputDirectory": "output",
  "headers": [
    {
      "source": "/(.*).m3u",
      "headers": [
        {
          "key": "Content-Type",
          "value": "audio/x-mpegurl; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
